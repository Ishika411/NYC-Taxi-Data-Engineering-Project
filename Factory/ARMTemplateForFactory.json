                "parameters": {
                    "p_year": {
                        "type": "String"
                    }
                },
                "annotations": [],
                "type": "Parquet",
                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "folderPath": {
                            "value": "trip_data@{dataset().p_year}",
